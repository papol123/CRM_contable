# ==============================================================================
# CONFIGURACIÓN GENERAL DEL ENTORNO
# ==============================================================================
NODE_ENV=development
PORT=3000

# ==============================================================================
# GOOGLE CLOUD PLATFORM (GCP)
# ==============================================================================
GCP_PROJECT_ID=tu-id-de-proyecto-gcp
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json
GCP_STORAGE_BUCKET_NAME=tu-bucket-storage

# ==============================================================================
# BASE DE DATOS POSTGRESQL (CLOUD SQL)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=crm_contable
DB_SSL=false

# ==============================================================================
# SEGURIDAD Y JWT
# ==============================================================================
JWT_SECRET=cambiar_por_clave_secreta_jwt
JWT_EXPIRATION=8h
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ==============================================================================
# APLICACIÓN
# ==============================================================================
# Orígenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:3001
# Zona horaria usada para la fecha de "hoy" (facturas, dashboard, cartera)
APP_TIMEZONE=America/Bogota

# ==============================================================================
# FACTURACIÓN ELECTRÓNICA DIAN (OPCIONAL)
# Ver backend/docs/facturacion-electronica.md. Apagada no afecta nada.
# ==============================================================================
FACTURACION_ELECTRONICA=false
# ninguno | (proveedor tecnológico que se integre en el futuro)
FACTURACION_PROVEEDOR=ninguno
# 2 = pruebas / habilitación, 1 = producción
DIAN_AMBIENTE=2
