# ==============================================================================
# CONFIGURACIÓN GENERAL DEL ENTORNO
# ==============================================================================
NODE_ENV=development
PORT=3000
# false desactiva /api/docs (Swagger)
SWAGGER=true

# ==============================================================================
# GOOGLE CLOUD PLATFORM (GCP)
# En Cloud Run se usan las credenciales de la cuenta de servicio; localmente,
# GOOGLE_APPLICATION_CREDENTIALS apunta a un JSON que NUNCA se versiona.
# ==============================================================================
GCP_PROJECT_ID=tu-id-de-proyecto-gcp
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json

# Almacenamiento de adjuntos, PDFs y exportaciones: gcs | local
# Sin STORAGE_DRIVER se usa gcs si GCP_STORAGE_BUCKET_NAME es real, si no local
STORAGE_DRIVER=local
GCP_STORAGE_BUCKET_NAME=tu-bucket-storage
# Carpeta para STORAGE_DRIVER=local (solo desarrollo)
STORAGE_LOCAL_DIR=./uploads

# Respaldos bajo demanda (POST /admin/backups) con la API de Cloud SQL Admin.
# La cuenta de servicio necesita roles/cloudsql.editor sobre la instancia.
CLOUD_SQL_INSTANCE=crm-contable-db

# ==============================================================================
# BASE DE DATOS POSTGRESQL (CLOUD SQL)
# Para desarrollo sin tocar Cloud SQL: npm run db:local (puerto 54329)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=crm_contable
DB_SSL=false
# true escribe el SQL en la consola
DB_LOGGING=false

# ==============================================================================
# SEGURIDAD Y JWT
# ==============================================================================
JWT_SECRET=cambiar_por_clave_secreta_jwt
# Vida corta del access token; la sesión se renueva con el refresh token (cookie HttpOnly)
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7
# Peticiones por minuto por IP (login, refresh y recuperación tienen límites propios)
THROTTLE_LIMIT=300
# Saltos de proxy confiables para X-Forwarded-For (Cloud Run = 1)
TRUST_PROXY_HOPS=1
# Base de la URI "type" de los errores RFC 9457
API_ERRORS_BASE_URL=https://api.tudominio.com/errors

# ==============================================================================
# CORREO (recuperación de contraseña, invitaciones, cotizaciones, recordatorios)
# Host, puerto, usuario y remitente se administran en PATCH /configuracion/correo.
# La contraseña SOLO va aquí (en GCP, montada desde Secret Manager).
# ==============================================================================
SMTP_PASSWORD=
# log = escribe los correos en la consola en lugar de enviarlos (solo fuera de producción)
CORREO_MODO=log

# ==============================================================================
# TAREAS ASÍNCRONAS (exportaciones, envíos de correo, respaldos)
# En Cloud Run despliegue con CPU siempre asignada o una instancia mínima
# para que el worker procese la cola sin tráfico.
# ==============================================================================
JOBS_WORKER=true
JOBS_INTERVALO_MS=3000

# ==============================================================================
# APLICACIÓN
# ==============================================================================
# Orígenes permitidos por CORS (separados por coma). El primero se usa en los
# enlaces de recuperación de contraseña e invitación.
FRONTEND_URL=http://localhost:3001
# Zona horaria usada para la fecha de "hoy" (remisiones, dashboard, cartera)
APP_TIMEZONE=America/Bogota
