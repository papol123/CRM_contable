meta {
  name: No se cierra el mes en curso - 422
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/reportes/cierre-mensual
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "periodo": "{{mesActual}}"
  }
}

script:pre-request {
  bru.setEnvVar("mesActual", new Date().toISOString().slice(0, 7));
}

tests {
  test("responde 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
}
