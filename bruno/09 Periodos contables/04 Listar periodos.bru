meta {
  name: Listar periodos
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/periodos-contables
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  const mes = bru.getEnvVar("mesCerrado");
  const p = res.getBody().find((x) => `${x.anio}-${String(x.mes).padStart(2, "0")}` === mes);
  if (p) bru.setEnvVar("idPeriodo", p.id_periodo);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
