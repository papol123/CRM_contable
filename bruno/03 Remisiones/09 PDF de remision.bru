meta {
  name: PDF de remision
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/facturas-venta/{{idRemision}}/pdf
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUsuario}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("devuelve un PDF", function () {
    expect(res.getHeader("content-type")).to.contain("application/pdf");
  });
}
