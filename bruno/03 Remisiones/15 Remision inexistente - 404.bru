meta {
  name: Remision inexistente - 404
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/facturas-venta/00000000-0000-4000-8000-000000000000
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUsuario}}
}

tests {
  test("responde 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
  test("error en formato RFC 9457 (application/problem+json)", function () {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody()).to.have.property("type");
    expect(res.getBody()).to.have.property("instance");
  });
}
