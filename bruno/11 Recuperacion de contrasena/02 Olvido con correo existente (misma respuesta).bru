  auth: none
}

body:json {
  {
    "email": "caja@crmcontable.com"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("no revela si el correo existe", function () {
    expect(res.getBody().message).to.equal(bru.getEnvVar("mensajeOlvido"));
  });
}
