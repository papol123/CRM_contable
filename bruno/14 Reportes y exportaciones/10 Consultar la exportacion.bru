meta {
  name: Consultar la exportacion
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/reportes/jobs/{{idJob}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUsuario}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("estado del job", function () {
    expect(["PENDIENTE", "EN_PROCESO", "COMPLETADO"]).to.include(res.getBody().estado);
  });
}

docs {
  Si aún está PENDIENTE, espere unos segundos y repita: el worker procesa la cola cada 3 s.
}
