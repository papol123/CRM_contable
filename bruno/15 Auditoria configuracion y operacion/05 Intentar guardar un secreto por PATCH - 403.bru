meta {
  name: Intentar guardar un secreto por PATCH - 403
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/configuracion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "CORREO_PASSWORD": "x"
  }
}

tests {
  test("responde 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
