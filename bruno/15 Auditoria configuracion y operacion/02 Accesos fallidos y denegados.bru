meta {
  name: Accesos fallidos y denegados
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/auditoria/accesos?resultado=FALLO
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("registra LOGIN_FALLIDO y ACCESO_DENEGADO", function () {
    const acciones = res.getBody().data.map((a) => a.accion);
    expect(acciones).to.include("LOGIN_FALLIDO");
    expect(acciones).to.include("ACCESO_DENEGADO");
  });
}
