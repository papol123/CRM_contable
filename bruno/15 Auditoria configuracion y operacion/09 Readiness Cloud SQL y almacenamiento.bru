meta {
  name: Readiness Cloud SQL y almacenamiento
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/health/ready
  body: none
  auth: none
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("base y almacenamiento arriba", function () {
    expect(res.getBody().checks.database.status).to.equal("up");
    expect(res.getBody().checks.storage.status).to.equal("up");
  });
}
