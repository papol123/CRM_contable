meta {
  name: Usuario busca clientes (sin contacto ni cupo)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/clientes/buscar?q={{documentoCliente}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUsuario}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("solo id, nombre, documento y estado", function () {
    expect(res.getBody().length).to.be.above(0);
    expect(Object.keys(res.getBody()[0]).sort()).to.eql(["activo", "creditoBloqueado", "id", "numeroDocumento", "razonSocial"]);
  });
}
