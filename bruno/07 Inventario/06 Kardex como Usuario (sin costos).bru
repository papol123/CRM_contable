meta {
  name: Kardex como Usuario (sin costos)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/inventario/{{idProducto}}/kardex
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUsuario}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("no expone costos al Usuario", function () {
    expect(res.getBody().movimientos[0]).to.not.have.property("costoUnitario");
  });
}
