meta {
  name: Validacion de DTO - 400 con lista de errores
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "campoInventado": 1
  }
}

tests {
  test("responde 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("lista los errores en errors[]", function () {
    expect(res.getBody().errors).to.be.an("array").that.is.not.empty;
  });
}
