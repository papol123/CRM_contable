meta {
  name: Login con correo inexistente - 401 generico
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "noexiste@crmcontable.com",
    "password": "Cualquiera123"
  }
}

tests {
  test("responde 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
  test("error en formato RFC 9457 (application/problem+json)", function () {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody()).to.have.property("type");
    expect(res.getBody()).to.have.property("instance");
  });
  test("no revela si el correo existe", function () {
    expect(res.getBody().detail).to.equal("Correo o contraseña incorrectos");
  });
}
