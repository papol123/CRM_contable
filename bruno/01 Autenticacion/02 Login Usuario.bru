meta {
  name: Login Usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "usuario@crmcontable.com",
    "password": "{{claveSemilla}}"
  }
}

script:post-response {
  bru.setEnvVar("tokenUsuario", res.getBody().accessToken);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("entrega accessToken y permisos", function () {
    expect(res.getBody().accessToken).to.be.a("string");
    expect(res.getBody().user.permisos).to.be.an("array");
  });
}
