meta {
  name: Usuario consulta nomina - 403
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/nomina
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenUsuario}}
}

tests {
  test("responde 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
  test("error en formato RFC 9457 (application/problem+json)", function () {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody()).to.have.property("type");
    expect(res.getBody()).to.have.property("instance");
  });
}

docs {
  La nómina es solo del Administrador (nomina.consultar). El resto de esta carpeta usa {{tokenAdmin}}.
}
